generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model boards {
  id          BigInt        @id @default(autoincrement())
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  url         String        @db.VarChar(500)
  posts       posts[]
  user_boards user_boards[]
}

model notifications {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  post_id    BigInt
  type       String   @db.VarChar(20)
  reason     String   @db.VarChar(20)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created")
}

model post_versions {
  id         BigInt   @id @default(autoincrement())
  post_id    BigInt
  content    String
  created_at DateTime @default(now()) @db.Timestamp(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post_id], map: "idx_post_versions_post_id")
}

model posts {
  id            BigInt          @id @default(autoincrement())
  board_id      BigInt
  external_id   BigInt
  title         String          @db.VarChar(255)
  content       String
  url           String          @db.VarChar(500)
  author        String?         @db.VarChar(100)
  content_hash  String?         @db.VarChar(100)
  published_at  DateTime?       @db.Timestamp(6)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  notifications notifications[]
  post_versions post_versions[]
  boards        boards          @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([board_id, external_id], map: "unique_board_external")
  @@index([board_id], map: "idx_posts_board_id")
}

model user_boards {
  user_id  BigInt
  board_id BigInt
  boards   boards @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, board_id])
  @@index([board_id], map: "idx_user_boards_board_id")
}

model user_keywords {
  id      BigInt @id @default(autoincrement())
  user_id BigInt
  keyword String @db.VarChar(50)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([keyword], map: "idx_user_keywords_keyword")
  @@index([user_id], map: "idx_user_keywords_user_id")
}

model users {
  id            BigInt          @id @default(autoincrement())
  email         String          @unique @db.VarChar(100)
  password_hash String          @db.VarChar(500)
  nickname      String          @db.VarChar(50)
  fcm_token     String?         @db.VarChar(500)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  notifications notifications[]
  user_boards   user_boards[]
  user_keywords user_keywords[]
}
